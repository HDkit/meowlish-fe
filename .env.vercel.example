# Copy to .env.vercel (gitignored). Read by scripts/vercel-deploy.sh (`npm run share`).

# Token from https://vercel.com/account/tokens. Leave empty to use `npx vercel login` instead.
# Optional: deploy somewhere other than the meowlish-fe-share project.
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
VERCEL_TOKEN=

# Team slug, only if the project lives under a team rather than your personal account.
VERCEL_SCOPE=

# Public backend gateway the deployed app proxies /api/* to. Must not be localhost.
VERCEL_API_URL=https://meowlish.servebeer.com
